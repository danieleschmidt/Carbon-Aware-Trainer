{
  "carbon_aware": {
    "mode": "production",
    "carbon_threshold": 80,
    "pause_threshold": 120,
    "resume_threshold": 60,
    "check_interval": 120,
    "optimization_mode": "balanced",
    "target_utilization": 0.75,
    "max_concurrent_jobs": 8,
    "resilience": {
      "enabled": true,
      "max_failures": 3,
      "checkpoint_interval": 50,
      "backup_enabled": true,
      "health_check_interval": 60
    },
    "regions": {
      "preferred": [
        "US-WA",
        "EU-FR",
        "CA-QC",
        "EU-NO"
      ],
      "excluded": [
        "US-WV",
        "PL",
        "IN-UP",
        "ZA"
      ],
      "migration_enabled": true
    },
    "monitoring": {
      "enabled": true,
      "prometheus_port": 8080,
      "metrics_interval": 30,
      "log_level": "INFO",
      "alerting": {
        "enabled": true,
        "high_carbon_threshold": 150,
        "failure_threshold": 3,
        "webhook_url": "https://hooks.slack.com/your-webhook"
      }
    }
  }
}